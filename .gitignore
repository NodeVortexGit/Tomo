# Your settings — never commit them
.env

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Runtime data (memory, audit log, health schedule, logs). It normally lives
# in the data folder (%APPDATA%\tomo\tomo\data or ~/.local/share/tomo), but
# ignore any local copies:
chroma/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
command-audit.log
health.json
tomo.lock
tomo.log

# Character models carry their own licences (see each .vrm's meta). Keep them
# local unless the licence allows redistribution — then whitelist them here.
assets/characters/*.vrm
!assets/characters/female model.vrm

# Windows installer build products (packaging/windows)
packaging/windows/uv/
packaging/windows/Output/
