# ─────────────────────────────────────────────────────────────────────────
#  Tomo configuration — copy this file to `.env` and fill in your keys.
#  install.sh does the copy for you if `.env` doesn't exist yet.
#  NEVER commit your real `.env` (it's in .gitignore).
# ─────────────────────────────────────────────────────────────────────────

# ── The decision-maker: Claude (Anthropic Messages API) ──────────────────
# Required: an Anthropic API key (starts with sk-ant-). Get one at
# https://console.anthropic.com/settings/keys
# (Older .env files with OPENAI_API_KEY / OPENAI_MODEL still work.)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5
# How much Claude thinks before answering: low (quick replies, the default),
# medium, high, xhigh or max.
# TOMO_EFFORT=low
# Only if you go through a gateway/proxy:
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Text-to-speech (Edge-TTS, free, no key) ──────────────────────────────
# Full voice list:  edge-tts --list-voices
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%

# ── "Hey Tomo" (offline wake word + speech-to-text) ──────────────────────
# Vosk listens for "Hey Tomo" and Whisper transcribes what you ask — all on
# this machine; no audio leaves it. install.sh downloads the models.
TOMO_WAKE_WORD=true

# ── Speech-to-text fallback (Google Cloud Speech-to-Text) ────────────────
# Only used for the Talk button when TOMO_WAKE_WORD is off. Create an API key
# in Google Cloud and enable the "Cloud Speech-to-Text API".
GOOGLE_STT_API_KEY=
STT_LANGUAGE=en-US

# ── Character / persona ──────────────────────────────────────────────────
TOMO_PERSONA=Tomo
# Absolute path to a .vrm to load on first run. If unset, Tomo looks for
# ~/.local/share/tomo/characters/default.vrm (drop one there, or import in-app).
# TOMO_CHARACTER=/home/you/models/mycharacter.vrm
# Which monitor Tomo lives on, by its name (`hyprctl monitors`, `swaymsg -t
# get_outputs`). Unset: the one the compositor picks, usually the focused one.
# TOMO_OUTPUT=DP-1

# ── Safety ───────────────────────────────────────────────────────────────
# Master switch for the AI acting on the machine: running shell commands AND
# driving the mouse/keyboard. "false" makes the assistant log-only (it records
# what it WOULD have done, and refuses to click/type). You can also flip control
# off live with the panic hotkey (Ctrl+Alt+Esc, or the Pause key).
TOMO_ALLOW_COMMANDS=true
# Optional comma-separated extra command prefixes you explicitly trust.
# TOMO_EXTRA_ALLOWED=
# Whether Tomo may take screenshots to see your screen (she tells you in the
# chat each time she looks; screenshots go to the Claude API).
TOMO_ALLOW_SCREEN=true

# ── Paths (usually leave unset; sensible XDG defaults are used) ───────────
# TOMO_DATA_DIR=/home/you/.local/share/tomo
# TOMO_SCRIPTS_DIR=/opt/tomo/scripts
