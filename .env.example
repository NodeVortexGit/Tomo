# ─────────────────────────────────────────────────────────────────────────
#  Tomo settings. Everything runs on this computer: no cloud services and
#  no API keys. The defaults work as they are; change what you like.
#  (Linux: install.sh copies this to `.env`. Windows: the installer puts it
#  in Tomo's folder — Start menu → "Tomo settings".)
# ─────────────────────────────────────────────────────────────────────────

# ── The model that thinks for Tomo: Ollama or LM Studio ──────────────────
# auto (the default) uses Ollama if it's running, else LM Studio's local
# server. Or pick one: ollama, lmstudio, openai (any other server with an
# OpenAI-compatible API, at TOMO_LLM_URL).
# TOMO_LLM=auto
# The server's address, if not the usual one on this computer
# (Ollama http://127.0.0.1:11434, LM Studio http://127.0.0.1:1234/v1).
# TOMO_LLM_URL=
# Which model. Tomo's is qwen3.5:9b (ollama pull qwen3.5:9b): it uses tools
# well, speaks English and Bulgarian, sees images (the ones you send, your
# screen, a character's picture to choose its voice) and runs entirely on an
# 8 GB graphics card. Empty: qwen3.5:9b if it's there, else the first local
# chat model the server has. Whichever you pick, it's the only one used.
TOMO_LLM_MODEL=qwen3.5:9b
# How much conversation the model reads at once, in tokens (Ollama only).
# TOMO_LLM_CONTEXT=8192
# Let a "thinking" model (qwen3.5, deepseek-r1…) reason before each reply.
# Smarter on hard requests, but it writes thousands of words first: a reply
# takes a minute instead of a few seconds. (Ollama only.)
# TOMO_LLM_THINK=false
# How long Ollama keeps the model in memory after a reply: 1h, 30m, or -1
# for always. Loading it again takes a while (half a minute for a big one).
# Tomo also loads it when it starts. (Ollama only.)
# TOMO_LLM_KEEP_ALIVE=1h
# Only if your server asks for a key (LM Studio with authentication on).
# TOMO_LLM_API_KEY=

# ── Voice (Piper, on this computer) ───────────────────────────────────────
# Tomo answers in the language you use, and speaks it: Bulgarian in the
# Bulgarian voice; English in the character's own — the male voice for a
# male character, the female one for a female character. The model decides
# which a character is, from its picture, the first time it appears; ask
# Tomo for the other voice any time. Any Piper voice works here
# (https://rhasspy.github.io/piper-samples/); it's downloaded when first used.
TOMO_TTS_VOICE_MALE=en_GB-alan-medium
TOMO_TTS_VOICE_FEMALE=en_GB-cori-medium
TOMO_TTS_VOICE_BG=bg_BG-dimitar-medium
# Speaking speed: 1.0 normal, 1.2 a fifth faster.
TOMO_TTS_SPEED=1.0

# ── "Hey Tomo" (Vosk + Parakeet, on this computer) ────────────────────────
# Listen for "Hey Tomo". With false, the microphone is only used while the
# Talk button records.
TOMO_WAKE_WORD=true

# ── Character / persona ──────────────────────────────────────────────────
TOMO_PERSONA=Tomo
# A .vrm to show on first run. Unset: the one that ships with Tomo, or any
# in the characters folder. Others can be imported from the chat's 👤 menu.
# TOMO_CHARACTER=/home/you/models/mycharacter.vrm

# ── Memory (ChromaDB, in the data folder) ────────────────────────────────
# How memories are matched when Tomo searches them: "ngram" (built in, works
# offline, in any language) or "minilm" (ChromaDB's English sentence model,
# downloaded the first time).
# TOMO_EMBEDDINGS=ngram

# ── Window (Linux) ────────────────────────────────────────────────────────
# Tomo uses X11 (XWayland under Wayland), where a window can stay on top and
# let clicks through. "wayland" asks for native Wayland instead.
# TOMO_GLFW_PLATFORM=x11

# ── Safety ───────────────────────────────────────────────────────────────
# Master switch for the AI acting on the machine: running shell commands AND
# driving the mouse/keyboard. "false" makes the assistant log-only (it records
# what it WOULD have done, and refuses to click/type). You can also flip control
# off live with the panic hotkey (Ctrl+Alt+Esc, or the Pause key).
TOMO_ALLOW_COMMANDS=true
# Optional comma-separated extra command prefixes you explicitly trust.
# TOMO_EXTRA_ALLOWED=
# Whether Tomo may take screenshots to see your screen. She tells you in the
# chat each time she looks, and the picture only goes to your local model.
TOMO_ALLOW_SCREEN=true

# ── Paths and the log (usually leave unset) ──────────────────────────────
# TOMO_DATA_DIR=/home/you/.local/share/tomo
# TOMO_SCRIPTS_DIR=/opt/tomo/scripts
# How much tomo.log (in the data folder) records: info, or debug for more.
# TOMO_LOG=info
